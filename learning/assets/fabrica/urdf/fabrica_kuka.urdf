<?xml version="1.0" ?>
<!--
KUKA LBR iiwa7 + Y-gripper, single arm, for Isaac Gym.

Geometry/inertials/joint limits ported from the hardware-canonical
description at ~/Grasp_Planning/assets/urdf/kuka_iiwa7_y_gripper/urdf/kuka_iiwa7_y_gripper.urdf
(link/joint names renamed to the kuka_ prefix convention used by this repo's
task code, matching the panda_ convention of fabrica_franka.urdf).

Deviation from the hardware URDF: right_finger_joint's mimic tag is
dropped and both finger joints are independently actuated prismatic DOFs.
Isaac Gym's URDF importer does not honor mimic tags, and the Fabrica task
code already expects two independently-commanded, symmetrically-driven
finger DOFs (gripper_dof_pos = dof_pos[:, 7:9], gripper_prop/deriv_gains
lists of 2), the same pattern already used for fabrica_franka.urdf's two
independent panda_finger_joint1/2.
-->
<robot name="kuka">

  <link name="kuka_link0">
    <visual>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/base_link.STL"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0128567641 7.05371085e-07 0.0679655593"/>
      <mass value="30.2763518"/>
      <inertia ixx="0.111239566" ixy="-3.81097437e-07" ixz="0.00486659751" iyy="0.139017104" iyz="7.87871532e-07" izz="0.133028622"/>
    </inertial>
  </link>

  <joint name="kuka_joint1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.1475"/>
    <parent link="kuka_link0"/>
    <child link="kuka_link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="176" lower="-2.97" upper="2.97" velocity="1.71"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="kuka_link1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.19"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link1.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.19"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link1.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-4.78790442e-07 -0.0348192059 0.120797868"/>
      <mass value="21.1627406"/>
      <inertia ixx="0.133321611" ixy="-5.38303163e-07" ixz="9.16989471e-07" iyy="0.127213841" iyz="0.0236704925" izz="0.0471553201"/>
    </inertial>
  </link>

  <joint name="kuka_joint2" type="revolute">
    <origin rpy="0 0 0" xyz="0 -0.0105 0.1925"/>
    <parent link="kuka_link1"/>
    <child link="kuka_link2"/>
    <axis xyz="0 1 0"/>
    <limit effort="176" lower="-2.09" upper="2.09" velocity="1.71"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="kuka_link2">
    <visual>
      <origin rpy="-1.57079633 0 0" xyz="0 0.0105 -0.0025"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link2.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="-1.57079633 0 0" xyz="0 0.0105 -0.0025"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link2.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-5.29061672e-07 0.0392906957 0.0844460685"/>
      <mass value="25.1403147"/>
      <inertia ixx="0.197631242" ixy="-3.51963819e-07" ixz="-9.50708464e-08" iyy="0.18755727" iyz="0.0367196702" izz="0.0602720614"/>
    </inertial>
  </link>

  <joint name="kuka_joint3" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.0105 0.2075"/>
    <parent link="kuka_link2"/>
    <child link="kuka_link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="110" lower="-2.97" upper="2.97" velocity="1.75"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="kuka_link3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.1893"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link3.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.1893"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link3.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="8.94264666e-07 0.0343188245 0.120097948"/>
      <mass value="21.1627874"/>
      <inertia ixx="0.133322418" ixy="-2.72387852e-07" ixz="-2.31579647e-07" iyy="0.127213838" iyz="-0.0236710393" izz="0.0471557501"/>
    </inertial>
  </link>

  <joint name="kuka_joint4" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.0105 0.1925"/>
    <parent link="kuka_link3"/>
    <child link="kuka_link4"/>
    <axis xyz="0 -1 0"/>
    <limit effort="110" lower="-2.09" upper="2.09" velocity="2.27"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="kuka_link4">
    <visual>
      <origin rpy="-1.57079633 0 0" xyz="0 -0.0105 -0.0032"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link4.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="-1.57079633 0 0" xyz="0 -0.0105 -0.0032"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link4.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="9.93437855e-08 -0.0397907045 0.0837462343"/>
      <mass value="25.140329"/>
      <inertia ixx="0.19763084" ixy="-3.24564289e-07" ixz="3.90828878e-07" iyy="0.187556898" iyz="-0.0367195589" izz="0.0602723071"/>
    </inertial>
  </link>

  <joint name="kuka_joint5" type="revolute">
    <origin rpy="0 0 0" xyz="0 -0.0105 0.2075"/>
    <parent link="kuka_link4"/>
    <child link="kuka_link5"/>
    <axis xyz="0 0 1"/>
    <limit effort="110" lower="-2.97" upper="2.97" velocity="2.44"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="kuka_link5">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.1886"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link5.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.1886"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link5.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-1.50596451e-07 -0.0298223596 0.0723663276"/>
      <mass value="9.53466993"/>
      <inertia ixx="0.0529038961" ixy="6.86274869e-08" ixz="3.57472027e-07" iyy="0.0444942714" iyz="0.0174914068" izz="0.0239916849"/>
    </inertial>
  </link>

  <joint name="kuka_joint6" type="revolute">
    <origin rpy="0 0 0" xyz="0 -0.0707 0.1925"/>
    <parent link="kuka_link5"/>
    <child link="kuka_link6"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" lower="-2.09" upper="2.09" velocity="3.14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="kuka_link6">
    <visual>
      <origin rpy="-1.57079633 0 0" xyz="0 0.0707 -0.0039"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link6.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="-1.57079633 0 0" xyz="0 0.0707 -0.0039"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link6.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="3.09820422e-06 0.0710485699 -0.00331157704"/>
      <mass value="14.2007599"/>
      <inertia ixx="0.0384515763" ixy="2.19173188e-06" ixz="6.70279498e-08" iyy="0.0368124807" iyz="0.00192249677" izz="0.028001094"/>
    </inertial>
  </link>

  <joint name="kuka_joint7" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.0707 0.091"/>
    <parent link="kuka_link6"/>
    <child link="kuka_link7"/>
    <axis xyz="0 0 1"/>
    <limit effort="40" lower="-3.05" upper="3.05" velocity="3.14"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="kuka_link7">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0311"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link7.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0311"/>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/link7.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="5.28878934e-07 3.37199922e-07 0.00360718224"/>
      <mass value="2.47156969"/>
      <inertia ixx="0.00177365937" ixy="-1.24105214e-07" ixz="-2.95409039e-08" iyy="0.00177328723" iyz="-1.57567641e-08" izz="0.00272748711"/>
    </inertial>
  </link>

  <joint name="kuka_hand_joint" type="fixed">
    <parent link="kuka_link7"/>
    <child link="kuka_hand"/>
    <origin rpy="0 0 3.14159265" xyz="0 0 0.0308"/>
  </joint>

  <link name="kuka_hand">
    <visual>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/hand.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/hand.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0273839865 0 0.0414999998"/>
      <mass value="0.8"/>
      <inertia ixx="0.00166886667" ixy="0" ixz="0" iyy="0.00145432361" iyz="0" izz="0.00196999027"/>
    </inertial>
  </link>

  <joint name="kuka_finger_joint1" type="prismatic">
    <parent link="kuka_hand"/>
    <child link="kuka_leftfinger"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0.0" upper="0.04" velocity="0.2"/>
    <dynamics damping="0.0" friction="5.0"/>
  </joint>

  <joint name="kuka_finger_joint2" type="prismatic">
    <parent link="kuka_hand"/>
    <child link="kuka_rightfinger"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="100" lower="0.0" upper="0.04" velocity="0.2"/>
    <dynamics damping="0.0" friction="5.0"/>
  </joint>

  <link name="kuka_leftfinger">
    <visual>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/left_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/left_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.0275000005 0.1105"/>
      <mass value="0.08"/>
      <inertia ixx="6.74733326e-05" ixy="0" ixz="0" iyy="5.67733333e-05" iyz="0" izz="3.89133326e-05"/>
    </inertial>
  </link>

  <link name="kuka_rightfinger">
    <visual>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/right_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../../urdf/kuka_description/meshes/right_finger.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.0275000005 0.1105"/>
      <mass value="0.08"/>
      <inertia ixx="6.74733326e-05" ixy="0" ixz="0" iyy="5.67733333e-05" iyz="0" izz="3.89133326e-05"/>
    </inertial>
  </link>

  <!--Used for calculating pose and Jacobian. Coincides with the hardware
  URDF's gripper_tcp frame (kuka_control's calibrated tool-center-point),
  which already sits at the midpoint between the fingers.-->
  <joint name="kuka_fingertip_centered_joint" type="fixed">
    <parent link="kuka_hand"/>
    <child link="kuka_fingertip_centered"/>
    <origin rpy="0 0 0" xyz="0 0 0.1455"/>
  </joint>

  <link name="kuka_fingertip_centered">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0e-6"/>
      <inertia ixx="1.0e-09" ixy="0" ixz="0" iyy="1.0e-09" iyz="0" izz="1.0e-09"/>
    </inertial>
  </link>

</robot>
