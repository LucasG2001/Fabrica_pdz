# geometry.py:131-132
def get_panda_grasp_base_offset():
    return 10.34 + 0.9

# geometry.py:135-154
def get_kuka_grasp_base_offset():
    # ... (comment explaining 14.55cm = gripper_tcp_joint offset)
    return 14.55

# geometry.py:157-158
def get_robotiq_85_grasp_base_offset(open_ratio):
    return 3.5 + np.sin(0.9208 + (1 - open_ratio) * 0.8757) * 5.715 + 6.93075 + 0.9

# geometry.py:161-162
def get_robotiq_140_grasp_base_offset(open_ratio):
    return 1.5 + 3.8 + np.sin(0.8680 + (1 - open_ratio) * 0.8757) * 10 + 5.4905 + 1.0
dispatched by get_gripper_grasp_base_offset at geometry.py:165-175. For KUKA it's a literal hardcoded 14.55 (cm) — not read from the URDF at runtime, just a number copied in from kuka_iiwa7_y_gripper.urdf's gripper_tcp_joint offset (0.1455 m).

